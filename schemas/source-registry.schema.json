{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yvakolov/urban-os/schemas/source-registry.schema.json",
  "title": "Реестр нормативных источников",
  "description": "Не источник права. Фиксирует, из какого экземпляра официального документа выполнена транскрипция, и как источники связаны между собой.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/authority"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "authority",
        "status",
        "transcribed"
      ],
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "string",
          "description": "Реквизиты акта"
        },
        "title": {
          "type": "string"
        },
        "adoptedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "effectiveFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "not_yet_adopted"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "normative_act",
            "methodological_recommendations",
            "reference_data",
            "external_authority"
          ],
          "description": "Что это за документ. methodological_recommendations выделены отдельно намеренно: рекомендация не обязательна, и правило, выведенное из неё, не может отвергать комплект наравне с нормой — иначе инструмент отбракует заявителя за несоблюдение того, что соблюдать не обязан."
        },
        "partOf": {
          "type": "string",
          "description": "Родительский источник"
        },
        "supersedes": {
          "type": "string"
        },
        "supersededBy": {
          "type": "string"
        },
        "amendedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Документы, вносившие изменения в действующую редакцию источника. Реквизиты приводятся так, как их называет сам источник. От supersedes отличается тем, что редакция остаётся той же самой, а не заменяется новой."
        },
        "contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file": {
          "type": "string",
          "description": "Путь к экземпляру документа"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256VerifiedOn": {
          "type": "string",
          "description": "Дата, когда объявленный sha256 был фактически сверен с файлом по адресу url. Нужна там, где файл в репозитории не хранится: хост может быть закрыт защитой от автоматических запросов, и тогда автоматическая сверка невозможна, а ручная — была. Без этой отметки url и sha256 остаются заявлением, а не проверкой."
        },
        "transcribedFromHash": {
          "type": "string",
          "description": "sha256 документа, с которого фактически велась транскрипция, когда сам документ источником признан не был. От sha256 отличается тем, что ничего не подтверждает: провенанса у такой записи нет. Служит опознавательным знаком — если публикация найдётся, хеш сразу скажет, тот ли это документ."
        },
        "provenanceGap": {
          "type": "string",
          "description": "Почему провенанс источника не подтверждается файлом в репозитории. Поле обязательно, если на источник опирается активный профиль, а файла нет: пробел должен быть виден в данных, а не жить молчаливым исключением в тесте."
        },
        "pages": {
          "type": [
            "string",
            "integer"
          ]
        },
        "textLayer": {
          "type": "boolean"
        },
        "appendices": {
          "type": "object"
        },
        "url": {
          "type": "string"
        },
        "transcribed": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "transcribedInto": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "id профилей requirements"
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "verdictKind": {
          "type": "string",
          "enum": [
            "external_verdict"
          ]
        }
      }
    }
  }
}
